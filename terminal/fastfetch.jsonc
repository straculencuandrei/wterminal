{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/logo.txt",
    "padding": {
      "top": 0,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "bright_black",
      "title": "bright_white"
    }
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "───────────────────────────────"
    },
    {
      "type": "os",
      "key": "os    "
    },
    {
      "type": "kernel",
      "key": "kernel"
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    {
      "type": "shell",
      "key": "shell "
    },
    {
      "type": "terminal",
      "key": "term  "
    },
    {
      "type": "cpu",
      "key": "cpu   "
    },
    {
      "type": "gpu",
      "key": "gpu   ",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "ram   "
    },
    {
      "type": "disk",
      "key": "disk  ",
      "folders": "C:\\"
    },
    "break",
    "colors"
  ]
}
